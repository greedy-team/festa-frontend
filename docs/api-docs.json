{
  "openapi": "3.1.0",
  "info": {
    "title": "festa API",
    "description": "축제 정보 서비스 festa의 API 문서. /api/admin 으로 시작하는 경로는 관리자 로그인으로 받은 토큰이 필요하다.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://161.33.7.55:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "관리자 - 임포트",
      "description": "CSV를 올려 반영 전 미리보기 배치를 만든다. 이 단계에서 데이터는 바뀌지 않는다. 토큰이 없거나 만료되면 401(UNAUTHORIZED / TOKEN_EXPIRED)이다."
    },
    {
      "name": "관리자 - 아티스트",
      "description": "아티스트의 등록·목록·수정·삭제와 중복 아티스트 병합. 토큰이 없거나 만료되면 401(UNAUTHORIZED / TOKEN_EXPIRED)이다."
    },
    {
      "name": "관리자 - 주최",
      "description": "축제를 여는 주최의 등록·조회·수정·삭제. 토큰이 없거나 만료되면 401(UNAUTHORIZED / TOKEN_EXPIRED)이다."
    },
    {
      "name": "관리자 - 인증",
      "description": "관리자 토큰 발급. 여기서 받은 토큰을 다른 관리자 API의 Authorization 헤더에 쓴다."
    },
    {
      "name": "관리자 - 축제",
      "description": "축제 검수 목록 조회와 발행·발행 취소, 주최별 데이터 구축 현황. 토큰이 없거나 만료되면 401(UNAUTHORIZED / TOKEN_EXPIRED)이다."
    }
  ],
  "paths": {
    "/api/admin/imports/{type}": {
      "post": {
        "tags": [
          "관리자 - 임포트"
        ],
        "summary": "임포트 단건 미리보기",
        "description": "type은 festivals / lineups / artists 중 하나다. onConflict는 UPDATE(기본) / SKIP.",
        "operationId": "previewSingle",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "onConflict": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성된 미리보기 배치와 행 목록",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ImportPreviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "IMPORT_INVALID_TYPE / IMPORT_MISSING_FILE / IMPORT_INVALID_CONFLICT_POLICY / IMPORT_EMPTY_CSV / IMPORT_INVALID_CSV_ENCODING / IMPORT_INVALID_CSV_HEADER / IMPORT_INVALID_CSV",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/imports/bundle": {
      "post": {
        "tags": [
          "관리자 - 임포트"
        ],
        "summary": "임포트 묶음 미리보기",
        "description": "festivals와 lineups는 필수, artists는 선택이다. onConflict는 UPDATE(기본) / SKIP.",
        "operationId": "previewBundle",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "festivals": {
                    "type": "string",
                    "format": "binary"
                  },
                  "lineups": {
                    "type": "string",
                    "format": "binary"
                  },
                  "artists": {
                    "type": "string",
                    "format": "binary"
                  },
                  "onConflict": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성된 미리보기 배치와 행 목록",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ImportPreviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "IMPORT_MISSING_FILE / IMPORT_INVALID_CONFLICT_POLICY / IMPORT_EMPTY_CSV / IMPORT_INVALID_CSV_ENCODING / IMPORT_INVALID_CSV_HEADER / IMPORT_INVALID_CSV",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
